doctype html
html(lang="en" "data-theme"="dark")
    head
        meta(charset="utf-8")
        meta(name="viewport", content="width=device-width,initial-scale=1.0")
        meta(name="color-scheme", content="dark")
        title #{Name}
        style
            include ../../public/styles.css
    body.vg
        header.vg-topbar
            div.vg-wrap
                span.vg-brand
                    svg.vg-icon(width="26" height="26" viewBox="0 0 24 24" "stroke-width"="1.8" "aria-hidden"="true")
                        rect(x="3" y="4" width="18" height="16" rx="2")
                        path(d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4")
                    span Video Gallery
        main.vg-wrap.vg-main.vg-gallery-main
            div.vg-intro
                span.vg-eyebrow #{Category}
                h1.vg-display #{Name}
                span.vg-muted
                    if len(Videos) == 1
                        | 1 video
                    else
                        | #{len(Videos)} videos
            div.vg-video-grid#videoGrid
                each Video in Videos
                    a.vg-tile(href=Video.Url)
                        if Video.Thumbnail
                            div.vg-thumb
                                img(src=Video.Thumbnail alt="" loading="lazy")
                                span.vg-play
                                    svg(width="22" height="22" viewBox="0 0 24 24" "aria-hidden"="true")
                                        path(d="M6 4.5v15l13-7.5z")
                        else
                            div.vg-thumb.is-missing
                                span.vg-thumb-note No preview yet
                                span.vg-play
                                    svg(width="22" height="22" viewBox="0 0 24 24" "aria-hidden"="true")
                                        path(d="M6 4.5v15l13-7.5z")
                        span.vg-tile-title #{Video.Name}
        script
            | /* Movie posters are portrait: once most thumbnails load taller than
            |    wide, switch the grid to poster-shaped tiles so they are not cropped. */
            | (function() {
            |     const grid = document.getElementById('videoGrid');
            |     const imgs = Array.from(grid.querySelectorAll('img'));
            |     let loaded = 0, portrait = 0;
            |     function check(img) {
            |         loaded++;
            |         if (img.naturalHeight > img.naturalWidth) portrait++;
            |         grid.classList.toggle('is-posters', portrait * 2 > loaded);
            |     }
            |     imgs.forEach(function(img) {
            |         if (img.complete && img.naturalWidth) check(img);
            |         else img.addEventListener('load', function() { check(img); });
            |     });
            | })();
